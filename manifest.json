/* =========================================================
   الرفيق — Service Worker
   الإصدار: v15
   ========================================================= */

'use strict';

/* =========================================================
   1) إصدار الكاش
   ========================================================= */

const CACHE_NAME = 'rafeeq-v15';

/* =========================================================
   2) ملفات Shell الأساسية
   ========================================================= */

const SHELL_FILES = [

    './',
    './index.html',

    './style.css',

    './app.js',
    './theme.js',

    './manifest.json',

    './icon-192.png',
    './icon-512.png'

];

/* =========================================================
   3) ملفات البيانات الكبيرة
   ========================================================= */

const DATA_FILES = [

    './quran-local.json',
    './tafsir-saadi.json',
    './arbaeen-data.json'

];

/* =========================================================
   4) صفحات التطبيق
   ========================================================= */

const APP_PAGES = [

    './index.html',

    './quran.html',
    './tafsir.html',
    './qibla.html',
    './prayer.html',
    './adhkar.html',
    './hisnul.html',
    './arbaeen.html',
    './more.html'

];

/* =========================================================
   5) ملفات الأصول
   ========================================================= */

const APP_ASSETS = [

    './style.css',

    './app.js',
    './theme.js',

    './manifest.json'

];

/* =========================================================
   6) أدوات URL
   ========================================================= */

function getPath(request) {

    return new URL(request.url).pathname;

}

function isSameOrigin(request) {

    return new URL(request.url).origin === self.location.origin;

}

/* =========================================================
   7) التحقق من نوع الملف
   ========================================================= */

function isDataFile(request) {

    const path = getPath(request);

    return DATA_FILES.some(file =>
        path.endsWith(file.replace('./', '/'))
    );

}

function isAppPage(request) {

    const path = getPath(request);

    return APP_PAGES.some(file =>
        path.endsWith(file.replace('./', '/'))
    );

}

function isAppAsset(request) {

    const path = getPath(request);

    return APP_ASSETS.some(file =>
        path.endsWith(file.replace('./', '/'))
    );

}

function isAdhanFile(request) {

    return getPath(request).endsWith('/adhan.mp3');

}

/* =========================================================
   8) INSTALL
   ========================================================= */

self.addEventListener('install', event => {

    console.log('🚀 تثبيت Service Worker', CACHE_NAME);

    event.waitUntil(

        caches.open(CACHE_NAME)

        .then(async cache => {

            for (const file of SHELL_FILES) {

                try {

                    const response = await fetch(file, {

                        cache: 'no-store'

                    });

                    if (response && response.ok) {

                        await cache.put(

                            file,

                            response.clone()

                        );

                    }

                } catch (error) {

                    console.warn(

                        'تعذر حفظ',

                        file,

                        error

                    );

                }

            }

        })

        .then(() => self.skipWaiting())

    );

});

/* =========================================================
   9) ACTIVATE — حذف الكاش القديم (فقط ما يبدأ بـ rafeeq-)
   ========================================================= */

self.addEventListener('activate', event => {

  console.log('⚡ تفعيل Service Worker', CACHE_NAME);

  event.waitUntil(

    caches.keys().then(cacheNames => {

      return Promise.all(

        cacheNames

          .filter(name => name.startsWith('rafeeq-') && name !== CACHE_NAME)

          .map(name => {

            console.log('🗑️ حذف الكاش القديم:', name);

            return caches.delete(name);

          })

      );

    }).then(() => self.clients.claim())

  );

});

/* =========================================================
   10) دالة fetchAndCache (مع await للحفظ)
   ========================================================= */

async function fetchAndCache(request, cache) {

  try {

    const response = await fetch(request);

    if (response && response.ok) {

      await cache.put(request, response.clone());
    }

    return response;

  } catch (error) {

    throw error;

  }

}

/* =========================================================
   11) استراتيجيات التخزين
   ========================================================= */

// Cache First — مناسب للأصول الثابتة التي لا تتغير كثيرًا

async function cacheFirst(request, cache) {

  const cachedResponse = await cache.match(request);

  if (cachedResponse) {

    return cachedResponse;

  }

  return fetchAndCache(request, cache);

}

// Stale While Revalidate — مناسب للبيانات والصفحات التي تحتاج تحديثًا تلقائيًا

async function staleWhileRevalidate(request, cache, event) {

  const cachedResponse = await cache.match(request);

  const fetchPromise = fetchAndCache(request, cache).catch(() => {

    // في حال فشل الجلب، نعتمد على المخبأ فقط

  });

  return cachedResponse || fetchPromise;
}

/* =========================================================
   12) FETCH
   ========================================================= */

self.addEventListener(

    'fetch',

    event => {

        const request = event.request;


        /* GET فقط */

        if (request.method !== 'GET') {

            return;

        }


        /* لا نتدخل في الطلبات الخارجية */

        if (!isSameOrigin(request)) {

            return;

        }


        /* ملف الأذان يمر مباشرة */

        if (isAdhanFile(request)) {

            event.respondWith(

                fetch(request)

            );

            return;

        }


        event.respondWith(

            caches.open(CACHE_NAME)

            .then(async cache => {


                /* البيانات (تستخدم Stale While Revalidate للتحديث التلقائي) */

                if (isDataFile(request)) {

                    return staleWhileRevalidate(

                        request,

                        cache,

                        event

                    );

                }


                /* صفحات التطبيق */

                if (isAppPage(request)) {

                    return staleWhileRevalidate(

                        request,

                        cache,

                        event

                    );

                }


                /* ملفات CSS / JS */

                if (isAppAsset(request)) {

                    return staleWhileRevalidate(

                        request,

                        cache,

                        event

                    );

                }


                /* باقي الملفات */

                const cached =

                    await cache.match(request);

                if (cached) {

                    return cached;

                }


                return fetchAndCache(

                    request,

                    cache

                );

            })

        );

    }

);


/* =========================================================
   13) الرسائل
   ========================================================= */

self.addEventListener(

    'message',

    event => {

        if (!event.data) {

            return;

        }


        /* تفعيل النسخة الجديدة */

        if (

            event.data.type ===

            'SKIP_WAITING'

        ) {

            self.skipWaiting();

        }


        /* حذف الكاش */

        if (

            event.data.type ===

            'CLEAR_CACHE'

        ) {

            event.waitUntil(

                caches.keys()

                .then(cacheNames =>

                    Promise.all(

                        cacheNames.map(

                            cacheName =>

                                caches.delete(

                                    cacheName

                                )

                        )

                    )

                )

            );

        }

    }

);


/* =========================================================
   14) تشخيص
   ========================================================= */

console.log(

    '🟢 الرفيق — Service Worker v15 جاهز'

);